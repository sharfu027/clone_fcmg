{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=ink_fmcg_erp_test;Username=postgres;Password=postgres",
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": true,
    "MaxRetryCount": 3
  },
  "Jwt": {
    "Issuer": "http://localhost:5000",
    "Audience": "http://localhost:3000",
    "Secret": "SuperSecretEnterpriseSecurityKeyWithMoreThan256BitsToSatisfySecurityConstraintChecks!",
    "ExpiryMinutes": 60
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "INK_ERP_TEST_"
  },
  "Hangfire": {
    "ConnectionString": "Host=localhost;Port=5432;Database=ink_fmcg_erp_test;Username=postgres;Password=postgres",
    "SchemaName": "hangfire"
  },
  "AllowedCorsOrigins": [
    "http://localhost:3000",
    "http://localhost:5173"
  ],
  "OpenTelemetry": {
    "EnableTracing": false,
    "ServiceName": "INK.ERP.API.Testing"
  },
  "Application": {
    "EnvironmentName": "Testing",
    "AppVersion": "1.0.0-test"
  },
  "FaceRecognition": {
    "ModelPath": "models/insightface_mobilefacenet.onnx",
    "ModelVersion": "v2.1",
    "MinQualityScoreThreshold": 0.30,
    "MatchThreshold": 0.35
  },
  "AllowedHosts": "*"
}
